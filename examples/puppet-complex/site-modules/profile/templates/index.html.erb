<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>xform — <%= @facts['role'] || 'default' %> — Puppet Managed</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 640px; margin: 4rem auto; padding: 0 1rem; }
        h1 { color: #b00; }
        code { background: #f4f4f4; padding: 2px 6px; border-radius: 3px; }
        .meta { color: #666; font-size: 0.9rem; }
        table { border-collapse: collapse; width: 100%; margin-top: 1rem; }
        td, th { border: 1px solid #ddd; padding: 6px 10px; text-align: left; }
    </style>
</head>
<body>
    <h1>xform — Puppet Complex Example</h1>
    <p>Managed by <strong>Puppet</strong> on <code><%= @fqdn %></code></p>
    <table>
        <tr><th>Fact</th><th>Value</th></tr>
        <tr><td>Hostname</td><td><%= @hostname %></td></tr>
        <tr><td>OS</td><td><%= @operatingsystem %> <%= @operatingsystemrelease %></td></tr>
        <tr><td>OS Family</td><td><%= @facts['os']['family'] %></td></tr>
        <tr><td>IP Address</td><td><%= @facts['networking']['ip'] %></td></tr>
        <tr><td>Memory</td><td><%= @facts['memory']['system']['total'] %></td></tr>
        <tr><td>Environment</td><td><%= scope['profile::app::environment'] %></td></tr>
    </table>
    <p class="meta">
        App: <%= scope['profile::app::app_name'] %> on port <%= scope['profile::app::app_port'] %><br>
        Uptime: <%= @uptime %>
    </p>
</body>
</html>
