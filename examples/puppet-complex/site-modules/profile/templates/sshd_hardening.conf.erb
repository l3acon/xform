# Managed by Puppet — profile::security SSH hardening
PermitRootLogin no
PasswordAuthentication no
ChallengeResponseAuthentication no
UsePAM yes
X11Forwarding no
MaxAuthTries 3
ClientAliveInterval 300
ClientAliveCountMax 2
<% unless @allowed_ssh_networks.nil? || @allowed_ssh_networks.empty? -%>
# Allowed networks
<% @allowed_ssh_networks.each do |network| -%>
# AllowFrom <%= network %>
<% end -%>
<% end -%>
