# Managed by Ansible — roles/app
[Unit]
Description={{ app_name }} Application
After=network.target
{% if database_host is defined and database_host != 'localhost' %}
After=postgresql.service
Wants=postgresql.service
{% endif %}

[Service]
Type=simple
User={{ app_user }}
Group={{ app_group }}
WorkingDirectory={{ deploy_dir }}
ExecStart=/usr/bin/java {{ java_opts }} -jar {{ deploy_dir }}/bin/{{ app_name }}.jar --spring.config.location={{ deploy_dir }}/config/
Restart=always
RestartSec=10
StandardOutput=append:{{ deploy_dir }}/logs/{{ app_name }}.log
StandardError=append:{{ deploy_dir }}/logs/{{ app_name }}.error.log

Environment="JAVA_OPTS={{ java_opts }}"
Environment="APP_ENV={{ app_environment }}"

[Install]
WantedBy=multi-user.target
